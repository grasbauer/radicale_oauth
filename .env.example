# IMAP server for DAV client authentication
IMAP_HOST=mail.example.com:993

# --- oauth2-proxy (browser/web-UI OIDC) ---
OAUTH2_CLIENT_ID=radicale
OAUTH2_CLIENT_SECRET=change-me
OAUTH2_ISSUER_URL=https://your-keycloak/realms/your-realm
OAUTH2_COOKIE_SECRET=generate-with-openssl-rand-base64-32
OAUTH2_COOKIE_SECURE=false
